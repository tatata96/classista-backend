# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string
DATABASE_URL="postgresql://user:password@host:5432/database"

# development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# Allowed origin for CORS (comma-separated if you need more than one later)
CORS_ORIGIN=http://localhost:5173

# Supabase project URL (Project Settings > API). Used to verify auth tokens
# via the project's public JWKS endpoint; safe to expose, not a secret.
SUPABASE_URL=https://yvqrdwbytafknmdcsvuy.supabase.co
